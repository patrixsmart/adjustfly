{
    "name": "patrixsmart/adjustfly",
    "description": "Record Laravel model adjustments (audit trail) automatically on model events.",
    "keywords": [
        "laravel",
        "audit",
        "audit-trail",
        "activity-log",
        "eloquent",
        "revisions"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Patrick Duruamadi",
            "email": "patrickadvance@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Patrixsmart\\Adjustfly\\AdjustflyServiceProvider"
            ]
        }
    },
    "autoload": {
        "psr-4": {
            "Patrixsmart\\Adjustfly\\": "src/",
            "Patrixsmart\\Adjustfly\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Patrixsmart\\Adjustfly\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
